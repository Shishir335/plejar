extends baseEmail

block content
  p Hi #{firstName},
  p Use this code in the Plezar app to set a new password:
  p(style='font-size: 32px; font-weight: 700; letter-spacing: 10px; margin: 24px 0;') #{code}
  p The code works for 10 minutes. If you didn't ask for it, you can ignore this email; your password stays the same.
