extends baseEmail

block content
  p Hi #{firstName},
  p Good news: #{agencyName} has been accepted as a #{appName} member agency.
  p Your existing #{appName} account now opens the vendor panel too. Sign in with the same email (#{email}) and password you already use.
  table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  a(href=`${url}`, target='_blank') Open the vendor panel
  p Or go to #{url}
  p If your account has no password, for example because you sign in with Google, choose one with "Forgot your password?" on that page.
