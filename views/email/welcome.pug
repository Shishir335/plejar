extends baseEmail

block content
  p Hi #{firstName},
  p Welcome to #{appName || 'Plejar'}! We are thrilled to have you with us. 🎉
  p Your account is now active and ready to go.
  
  table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0', style='margin: 20px 0;')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  a(href=`${url}`, target='_blank') Get Started
  
  p If you ever need any assistance or have questions, feel free to reach out to our team anytime.
  p Warm regards,
  p - The Team