extends baseEmail

block content
  p Hi #{firstName},
  p We are reviewing the application for #{agencyName} (reference #{reference}) and need a little more from you:
  blockquote(style='margin:0 0 16px;padding:10px 14px;border-left:3px solid #1f7a55;background:#f5f7f2;') #{note}
  p You can reply and add documents on your application page.
  table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td(align='left')
          table(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
              tr
                td
                  a(href=`${url}`, target='_blank') Reply to our team
