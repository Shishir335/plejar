NODE_ENV=development
PORT=3000
APP_NAME=Plezar

# MongoDB Atlas Connection URI
DATABASE=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER_HOST>/plezar?retryWrites=true&w=majority
DATABASE_DEV=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER_HOST>/plezar_dev?retryWrites=true&w=majority
DATABASE_PASSWORD=your_password_here
DATABASE_LOCAL=mongodb://127.0.0.1:27017/plezar

# Security & Sessions
JWT_SECRET=replace_with_a_long_random_string
# Comma-separated emails that always get admin access (exact match)
ADMIN_EMAILS=you@example.com
# Comma-separated origins allowed to call the API cross-origin (leave empty for same-origin only)
CORS_ORIGINS=
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90

# Cloudinary (Media & Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Dispatcher (Gmail or SMTP/SendGrid)
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_gmail_app_password
EMAIL_FROM=support@plezar.com

# Optional SMTP fallback:
EMAIL_USERNAME=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Firebase Cloud Messaging (FCM Push Notifications)
# Path to your downloaded Firebase Service Account private key JSON file
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
