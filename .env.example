# Plejar backend settings. Copy to config.env for your laptop:  cp .env.example config.env
# On Render, enter these in each service's Environment tab instead (config.env is never committed).
#
# Three places run this server, and each one gets its own values:
#   Laptop      npm run dev          development mode, the dev database only
#   Staging     Render, dev branch   NODE_ENV=production, DATABASE = the dev/staging database
#   Production  Render, prod branch  NODE_ENV=production, DATABASE = the live database
# Only the production service should ever know the live database address and password.

# ---- Mode -------------------------------------------------------------------
# Set NODE_ENV in the shell or in Render's settings, not here: the server ignores it in this file.
# If it isn't set, Render runs as production and anywhere else runs as development.
# In development the server refuses any database whose name doesn't end in dev, test or staging
# (unless MongoDB runs on this machine), so it can't write to live data by accident.
PORT=3000
APP_NAME=Plejar
# The public address of this copy, used in emailed links and share links
# (https://www.plejar.com in production, https://staging.plejar.com on staging)
APP_URL=

# ---- MongoDB ----------------------------------------------------------------
# DATABASE: the database for production mode. Leave it empty on your laptop.
DATABASE=
# DATABASE_DEV: the database for development mode. Give it a database user that can only open plezar_dev.
DATABASE_DEV=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER_HOST>/plezar_dev?retryWrites=true&w=majority
# Replaces <PASSWORD> or <db_password> in the addresses above
DATABASE_PASSWORD=
# Used in development when DATABASE_DEV is empty
DATABASE_LOCAL=mongodb://127.0.0.1:27017/plezar_dev

# ---- Sign-in ----------------------------------------------------------------
# Use a different long random string in every copy, so a login from one doesn't work on another
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90
# Comma-separated emails that always get admin access (exact match)
ADMIN_EMAILS=you@example.com
# Comma-separated origins allowed to call the API cross-origin (leave empty for same-origin only)
CORS_ORIGINS=
# Shared secret Cloudflare adds to each request (utils/cloudflare.js). Leave empty on your laptop.
CF_ORIGIN_SECRET=

# Google sign-in client IDs (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_SERVER_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# ---- Uploads (Cloudinary) ---------------------------------------------------
# Leave empty on your laptop to save uploads to disk; use a separate account or folder for staging
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Top folder for this copy's files. Default: plezar in production mode, plezar-dev otherwise.
# Set it to plezar-dev on the dev Render service, which runs in production mode.
CLOUDINARY_FOLDER=

# ---- Email ------------------------------------------------------------------
# Leave GMAIL_USER and GMAIL_PASS empty on your laptop so no real email goes out
GMAIL_USER=
GMAIL_PASS=
EMAIL_FROM=support@plejar.com
# SMTP used in production (Brevo or SendGrid)
SENDGRID_USERNAME=
SENDGRID_PASSWORD=
# Optional SMTP fallback, e.g. Mailtrap for testing
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
# Monthly vendor reports run unless this is off; set it to off on your laptop and on staging
REPORT_SCHEDULER=

# ---- SMS --------------------------------------------------------------------
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# ---- Push notifications (Firebase) ------------------------------------------
# Use a separate Firebase project for staging so test pushes never reach real users.
# Either a path to the service account file, the file's JSON in one line, or the three fields.
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
